# Copy to .env.local and fill in only what you need. Everything here is OPTIONAL.
# Keys stay on the server: they are never sent to the browser and are redacted from errors.

# ── Local model (Ollama) ────────────────────────────────────────────────────
# Where Ollama listens. Default: http://127.0.0.1:11434
OLLAMA_HOST=
# Model used for assessments. Default (app.config.ts): qwen3:4b. Quality option: qwen3:8b
FACTCHECK_MODEL=

# ── Broader search (optional, bring your own key) ───────────────────────────
# Brave Search API — https://api-dashboard.search.brave.com/ . Enables "Broader web search".
BRAVE_SEARCH_API_KEY=
# Google Fact Check Tools API key — https://developers.google.com/fact-check/tools/api
GOOGLE_FACT_CHECK_API_KEY=

# ── Local data ──────────────────────────────────────────────────────────────
# Where the bounded cache lives. Default: ./.data  (delete it any time, or use Settings → Reset)
FACTCHECK_DATA_DIR=
# Set to 1 to skip GDELT (slow; measured 11–17 s per request and limited to 1 request / 5 s).
FACTCHECK_DISABLE_GDELT=
