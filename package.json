{
  "name": "fact-checker",
  "version": "0.1.0",
  "private": true,
  "description": "Before you believe it. Bring a claim, follow the evidence — local AI via Ollama, live bounded retrieval.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p ${PORT:-3016}",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p ${PORT:-3016}",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval:fixtures": "NODE_OPTIONS=--conditions=react-server tsx scripts/eval-fixtures.ts",
    "benchmark": "NODE_OPTIONS=--conditions=react-server tsx scripts/benchmark.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "fast-xml-parser": "^5.11.2",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.14",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.0.5"
  }
}
